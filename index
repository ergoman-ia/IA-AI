<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>산업재해원인 계층별 퍼즐 분석</title>
    <style>
        /* Keyframes for the spinner animation */
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        body {
            min-height: 100vh;
            background-color: #f0f4f8; /* Light blue-gray background */
            display: flex;
            flex-direction: column; /* Allow vertical stacking */
            align-items: center;
            justify-content: center;
            padding: 16px;
            font-family: sans-serif; /* Default sans-serif font */
            margin: 0; /* Remove default body margin */
        }

        /* Main content card for input and accident details */
        .main-content-card {
            background-color: #ffffff;
            padding: 32px;
            border-radius: 16px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            width: 100%; /* Default for mobile */
            box-sizing: border-box; /* Include padding and border in the element's total width and height */
            margin-bottom: 20px; /* Space between sections */
        }

        /* Desktop styles: max-width 800px */
        @media (min-width: 768px) { /* Common breakpoint for tablets and desktops */
            .main-content-card {
                max-width: 800px; /* Set max-width for larger screens */
            }
        }

        h1 {
            font-size: 36px; /* text-4xl */
            font-weight: 800; /* font-extrabold */
            text-align: center;
            color: #374151; /* text-gray-800 */
            margin-bottom: 32px; /* mb-8 */
            letter-spacing: -0.025em; /* tracking-tight */
        }

        .input-section > div {
            margin-bottom: 24px; /* space-y-6 equivalent */
        }

        label {
            display: block;
            font-size: 18px;
            font-weight: 500;
            color: #4b5563;
            margin-bottom: 8px;
        }

        select {
            width: 100%;
            padding: 10px 16px;
            border: 1px solid #d1d5db; /* border-gray-300 */
            border-radius: 8px; /* rounded-lg */
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); /* shadow-sm */
            font-size: 18px;
            transition: border-color 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            outline: none; /* Remove default focus outline */
        }

        select:focus {
            border-color: #3b82f6; /* focus:border-blue-500 */
        }

        .button-group {
            display: flex;
            gap: 10px; /* Space between buttons */
            margin-bottom: 10px;
        }

        .button-group button {
            flex: 1; /* Distribute space equally */
            margin-bottom: 0; /* Override individual button margin */
        }

        button {
            width: 100%;
            background: linear-gradient(to right, #ef4444, #ea580c); /* from-red-500 to-orange-600 */
            color: #ffffff;
            font-weight: 700; /* font-bold */
            padding: 12px 24px; /* py-3 px-6 */
            border-radius: 12px; /* rounded-xl */
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.06); /* shadow-lg */
            border: none;
            cursor: pointer;
            font-size: 18px;
            transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out, opacity 0.3s ease-in-out;
            margin-bottom: 10px; /* Space between buttons */
        }

        button.reset-button {
            background: linear-gradient(to right, #6b7280, #4b5563); /* Gray gradient for reset */
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .result-section {
            margin-top: 32px;
            padding-top: 24px;
            border-top: 1px solid #e5e7eb;
            word-break: keep-all;
        }

        .result-section h2 {
            font-size: 24px;
            font-weight: 600;
            color: #374151;
            margin-bottom: 16px;
            text-align: center;
        }

        .message {
            text-align: center;
            color: #dc2626;
            font-size: 18px;
            font-weight: 500;
            margin-bottom: 16px;
        }

        /* Loading spinner for overview generation */
        .loading-spinner {
            text-align: center;
            color: #3b82f6;
            font-size: 18px;
        }

        .loading-spinner div {
            animation: spin 1s linear infinite;
            display: inline-block;
            width: 32px;
            height: 32px;
            border: 4px solid #93c5fd; /* border-blue-300 */
            border-top-color: #3b82f6; /* border-t-blue-500 */
            border-radius: 50%;
        }

        .loading-spinner p {
            margin-top: 8px;
        }

        .accident-details {
            background-color: #fef2f2; /* bg-red-50 */
            padding: 16px;
            border-radius: 8px; /* rounded-lg */
            border: 1px solid #fca5a5; /* border-red-200 */
            box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06); /* shadow-inner */
            text-align: left;
            display: none; /* Hidden by default, shown after generation */
        }

        .accident-details > div {
            margin-bottom: 16px;
        }

        .accident-details h3 {
            font-size: 20px;
            font-weight: 700;
            color: #b91c1c;
            margin-bottom: 8px;
        }

        /* Style for bulleted lists */
        .bullet-list {
            list-style: none; /* Remove default bullet */
            padding-left: 0; /* Remove default padding */
            margin-top: 0;
            margin-bottom: 0;
        }

        .bullet-list li {
            font-size: 18px;
            color: #b91c1c;
            line-height: 1.6;
            margin-bottom: 8px; /* Space between list items */
            text-indent: -0.7em; /* Indent the text */
            padding-left: 1em; /* Add padding for the bullet */
            word-break: keep-all;
        }

        .bullet-list li:last-child {
            margin-bottom: 0;
        }


        /* AI-selected Core Causes Display */
        .core-causes-display {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px dashed #ccc;
        }

        .core-causes-display h3 {
            font-size: 18px;
            font-weight: 600;
            color: #374151;
            margin-bottom: 10px;
        }

        /* Loading spinner for Hierarchical Puzzle generation */
        .mandalart-loading-spinner {
            text-align: center;
            color: #3b82f6;
            font-size: 18px;
            margin-top: 10px; /* Position below the button */
        }

        .mandalart-loading-spinner div {
            animation: spin 1s linear infinite;
            display: inline-block;
            width: 32px;
            height: 32px;
            border: 4px solid #93c5fd;
            border-top-color: #3b82f6;
            border-radius: 50%;
        }

        .mandalart-loading-spinner p {
            margin-top: 8px;
        }


        /* Hierarchical Puzzle Specific Styles */
        .mandalart-container {
            background-color: #ffffff;
            padding: 32px;
            border-radius: 16px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            width: 100%;
            box-sizing: border-box;
            max-width: 800px; /* Same max-width as main-content-card */
            display: none; /* Hidden by default */
            flex-direction: column;
            align-items: center;
            word-break: keep-all;
        }

        .mandalart-grid {
            display: grid;
            gap: 5px; /* Gap between sub-grids in 9x9, or between cells in 3x3 */
            border: 2px solid #374151; /* Darker border for the overall grid */
            margin-top: 20px;
            width: 100%; /* Make grid responsive */
            aspect-ratio: 1 / 1; /* Keep it square */
            max-width: 750px; /* Limit max width for 9x9, adjust as needed */
        }

        .mandalart-grid.grid-3x3 {
            grid-template-columns: repeat(3, 1fr);
            max-width: 450px; /* 1.5 times the original 300px */
        }

        .mandalart-grid.grid-9x9 {
            grid-template-columns: repeat(3, 1fr); /* This grid holds 9 sub-grid containers */
            gap: 5px; /* Gap between the 3x3 sub-grids */
        }

        /* New: Styles for the 3x3 sub-grid containers within the 9x9 grid */
        .mandalart-subgrid-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2px; /* Smaller gap between cells within a sub-grid */
            border: 1px solid #90cdf4; /* Border for each 3x3 block */
            box-sizing: border-box; /* Ensure padding/border are included in size */
            aspect-ratio: 1 / 1; /* Ensure sub-grids are also square */
            cursor: pointer; /* Indicate clickable */
        }


        /* Responsive Font Sizes for Hierarchical Puzzle Cells */
        .mandalart-cell {
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #90cdf4; /* Border for individual cells */
            text-align: center;
            font-weight: 600;
            padding: 5px;
            box-sizing: border-box;
            white-space: normal; /* Allow text wrapping by default */
            overflow: hidden; /* Hide overflow, text-overflow: ellipsis will not work with normal wrapping */
            cursor: default;
            aspect-ratio: 1 / 1; /* Ensure cells are always square */
            line-height: 1.2; /* Add line height for better wrapping */
        }

        /* 3x3 Grid Font Sizes */
        .mandalart-grid.grid-3x3 .mandalart-cell {
            font-size: 4.2vw; /* 1.5x original 2.8vw */
        }
        .mandalart-grid.grid-3x3 .mandalart-cell.center-theme {
            font-size: 5.7vw; /* 1.5x original 3.8vw */
        }
        .mandalart-grid.grid-3x3 .mandalart-cell.main-category {
            font-size: 5vw; /* 1.5x original 3.3vw, rounded */
        }

        /* 9x9 Grid Font Sizes (applied to cells within mandalart-subgrid-container) */
        .mandalart-grid.grid-9x9 .mandalart-subgrid-container .mandalart-cell {
            font-size: 1.3vw;
        }
        .mandalart-grid.grid-9x9 .mandalart-subgrid-container .mandalart-cell.center-theme {
            font-size: 1.8vw;
        }
        .mandalart-grid.grid-9x9 .mandalart-subgrid-container .mandalart-cell.main-category {
            font-size: 1.6vw;
        }
        .mandalart-grid.grid-9x9 .mandalart-subgrid-container .mandalart-cell.sub-cause {
            font-size: 1vw;
        }

        /* Desktop Overrides for Font Sizes (min-width: 768px) */
        @media (min-width: 768px) {
            .mandalart-grid.grid-3x3 .mandalart-cell {
                font-size: 20px; /* 1.5x original 13px, rounded */
            }
            .mandalart-grid.grid-3x3 .mandalart-cell.center-theme {
                font-size: 26px; /* 1.5x original 17px, rounded */
            }
            .mandalart-grid.grid-3x3 .mandalart-cell.main-category {
                font-size: 23px; /* 1.5x original 15px, rounded */
            }

            .mandalart-grid.grid-9x9 .mandalart-subgrid-container .mandalart-cell {
                font-size: 9px;
            }
            .mandalart-grid.grid-9x9 .mandalart-subgrid-container .mandalart-cell.center-theme {
                font-size: 12px;
            }
            .mandalart-grid.grid-9x9 .mandalart-subgrid-container .mandalart-cell.main-category {
                font-size: 11px;
            }
            .mandalart-grid.grid-9x9 .mandalart-subgrid-container .mandalart-cell.sub-cause {
                font-size: 8px;
            }
        }


        .mandalart-cell.center-theme {
            font-weight: 800;
        }

        .mandalart-cell.main-category {
            font-weight: 700;
        }

        .mandalart-cell.sub-cause {
            font-weight: 500;
            /* cursor: pointer; */ /* Removed as it's no longer clickable */
        }

        /* Modal Styles */
        .modal {
            display: none; /* Hidden by default */
            position: fixed; /* Stay in place */
            z-index: 1000; /* Sit on top */
            left: 0;
            top: 0;
            width: 100%; /* Full width */
            height: 100%; /* Full height */
            overflow: auto; /* Enable scroll if needed */
            background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background-color: #fefefe;
            margin: auto;
            padding: 20px;
            border: 1px solid #888;
            width: 80%; /* Could be responsive */
            max-width: 500px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            position: relative;
        }

        .close-button {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
            position: absolute;
            top: 10px;
            right: 15px;
        }

        .close-button:hover,
        .close-button:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

        .modal-body {
            padding: 10px 0;
            font-size: 16px;
            color: #333;
        }

        /* New Modal for Expanded 3x3 Hierarchical Puzzle */
        .sub-mandalart-modal {
            display: none; /* Hidden by default */
            position: fixed; /* Stay in place */
            z-index: 1001; /* Higher than main modal */
            left: 0;
            top: 0;
            width: 100%; /* Full width */
            height: 100%; /* Full height */
            overflow: auto; /* Enable scroll if needed */
            background-color: rgba(0,0,0,0.6); /* Darker overlay */
            justify-content: center;
            align-items: center;
        }

        .sub-mandalart-modal-content {
            background-color: #ffffff;
            padding: 20px;
            border-radius: 16px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            width: 90%; /* Responsive width */
            max-width: 400px; /* Max width for the expanded 3x3 */
            position: relative;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .sub-mandalart-modal-content .close-button {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 30px;
            cursor: pointer;
            color: #666;
        }
        .sub-mandalart-modal-content .close-button:hover {
            color: #333;
        }

        .sub-mandalart-modal-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 5px;
            border: 2px solid #374151;
            width: 100%;
            aspect-ratio: 1 / 1; /* Keep it square */
            margin-top: 20px;
        }

        /* Font sizes for expanded 3x3 modal */
        .sub-mandalart-modal-grid .mandalart-cell {
            font-size: 3.5vw; /* Slightly larger for focus */
        }
        .sub-mandalart-modal-grid .mandalart-cell.center-theme {
            font-size: 4.5vw;
        }
        .sub-mandalart-modal-grid .mandalart-cell.main-category {
            font-size: 4vw;
        }
        .sub-mandalart-modal-grid .mandalart-cell.sub-cause {
            font-size: 3vw;
        }

        @media (min-width: 768px) {
            .sub-mandalart-modal-grid .mandalart-cell {
                font-size: 16px;
            }
            .sub-mandalart-modal-grid .mandalart-cell.center-theme {
                font-size: 20px;
            }
            .sub-mandalart-modal-grid .mandalart-cell.main-category {
                font-size: 18px;
            }
            .sub-mandalart-modal-grid .mandalart-cell.sub-cause {
                font-size: 14px;
            }
        }

        /* New Modal for Accident Details */
        .accident-details-modal {
            display: none; /* Hidden by default */
            position: fixed; /* Stay in place */
            z-index: 1002; /* Higher than other modals */
            left: 0;
            top: 0;
            width: 100%; /* Full width */
            height: 100%; /* Full height */
            overflow: auto; /* Enable scroll if needed */
            background-color: rgba(0,0,0,0.6); /* Darker overlay */
            justify-content: center;
            align-items: center;
        }

        .accident-details-modal-content {
            background-color: #fefefe;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            width: 90%;
            max-width: 900px; /* Max width for readability */
            max-height: 90vh; /* Added max-height for scrollability */
            overflow-y: auto; /* Enable vertical scrolling */
            position: relative;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            gap: 15px; /* Space between sections */
        }

        .accident-details-modal-content h2 {
            font-size: 28px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 15px;
            text-align: center;
        }

        .accident-details-modal-content h3 {
            font-size: 22px;
            font-weight: 600;
            color: #4b5563;
            margin-bottom: 10px;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 5px;
        }

        .accident-details-modal-content p, .accident-details-modal-content li {
            font-size: 17px;
            line-height: 1.5;
            color: #333;
        }

        .accident-details-modal-content .info-item {
            font-size: 18px;
            font-weight: 500;
            color: #1f2937;
        }
        .accident-details-modal-content .info-item strong {
            color: #b91c1c; /* Red for emphasis */
        }

        .accident-details-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            word-break: keep-all;
        }

        .accident-details-table th, .accident-details-table td {
            border: 1px solid #d1d5db;
            padding: 10px;
            text-align: left;
            vertical-align: middle;            
        }

        .accident-details-table th {
            background-color: #e5e7eb;
            font-weight: 600;
            text-align: center;
            color: #374151;
        }

        .accident-details-table td ul {
            list-style: none;
            padding-left: 0;
            margin: 0;            
        }

        .accident-details-table td ul li {
            margin-bottom: 5px;
            font-size: 16px;
            color: #4b5563;
        }
        .accident-details-table td ul li:last-child {
            margin-bottom: 0;
        }

        /* Specific styling for the new button */
        button#showAccidentDetailsButton {
            padding: 12px 20px; /* Increased horizontal padding */
            white-space: nowrap; /* Prevent text wrapping */
            font-size: 18px; /* Ensure font size is consistent */
            min-width: 180px; /* Ensure enough width for the text */
        }

    </style>
</head>
<body>
    <div class="main-content-card">
        <h1>산업재해원인 계층별 퍼즐 분석</h1>
        <h2 align="center" style="color: red;">-간헐적 비정형 작업, <span style="color:blue;">2025.8.26. 9.30 교육용-</span></h2>

        <div class="input-section">
            <div>
                <label for="industry">업종:</label>
                <select id="industry"></select>
            </div>

            <div>
                <label for="workType">작업유형:</label>
                <select id="workType"></select>
            </div>

            <div>
                <label for="workCharacteristic">작업특성:</label>
                <select id="workCharacteristic"></select>
            </div>

            <div class="button-group">
                <button id="generateOverviewButton">재해정보 생성</button>
                <button id="resetButton" class="reset-button">초기화</button>
            </div>
        </div>

        <div class="result-section">
            <h2>생성된 재해 정보:</h2>
            <p id="message" class="message" style="display: none;"></p>
            <div id="loadingSpinner" class="loading-spinner" style="display: none;">
                <div></div>
                <p>재해 정보를 생성 중입니다...</p>
            </div>
            <!-- accidentDetailsDiv is now hidden by default, shown after generation -->
            <div id="accidentDetails" class="accident-details">
                <div id="overviewContainer">
                    <h3>재해 개요:</h3>
                    <p id="overviewText"></p>
                </div>
                <!-- These will be hidden by JS after generation -->
                <div id="coreCausesSelection" class="core-causes-display" style="display: none;">
                    <label for="coreCausesSelect">재해발생 핵심원인 선택 (AI 추천):</label>
                    <select id="coreCausesSelect"></select>
                    <p id="selectedCoreCauseDisplay" style="margin-top: 10px; font-weight: bold; color: #b91c1c; display: none;"></p>
                </div>
            </div>
            <!-- 계층별 퍼즐 생성 버튼과 로딩 스피너를 재해 정보 섹션 아래로 이동 -->
            <button id="generateMandalartButton" style="margin-top: 20px; display: none;" disabled>계층별 퍼즐 생성</button>
            <div id="mandalartLoadingSpinner" class="mandalart-loading-spinner" style="display: none;">
                <div></div>
                <p>계층별 퍼즐 생성 중입니다...</p>
            </div>
        </div>
    </div>

    <div id="mandalartContainer" class="mandalart-container">
        <h2>산업재해 계층별 퍼즐 분석</h2>
        <div id="mandalartGrid" class="mandalart-grid grid-3x3">
            <!-- 계층별 퍼즐 cells will be rendered here by JS -->
        </div>
        <!-- New button group below the grid -->
        <div class="button-group" style="margin-top: 20px;">
            <button id="expandMandalartButton" style="display: none;" disabled>계층별 퍼즐 확장</button>
            <button id="showAccidentDetailsButton" style="display: none;">재해원인/예방대책</button>
        </div>
    </div>

    <!-- New Modal Structure for Expanded 3x3 Hierarchical Puzzle (existing) -->
    <div id="subMandalartModal" class="sub-mandalart-modal">
        <div class="sub-mandalart-modal-content">
            <span class="close-button" id="closeSubMandalartModal">&times;</span>
            <h2>확장된 계층별 퍼즐 블록</h2>
            <div id="subMandalartGrid" class="sub-mandalart-modal-grid">
                <!-- Expanded 3x3 Hierarchical Puzzle cells will be rendered here -->
            </div>
        </div>
    </div>

    <!-- New Modal for Detailed Accident Information -->
    <div id="accidentDetailsModal" class="accident-details-modal">
        <div class="accident-details-modal-content">
            <span class="close-button" id="closeAccidentDetailsModal">&times;</span>
            <h2>재해원인 상세분석 및 예방대책 보고서</h2>

            <!-- 1. 재해 개요 -->
            <div>
                <h3>1. 재해 개요:</h3>
                <p id="modalOverviewText"></p>
            </div>

            <!-- 2. 핵심원인 및 피해정도 -->
            <div>
                <h3>2. 핵심원인 및 피해정도:</h3>
                <ul class="bullet-list">
                    <li><span style="font-weight: bold; color: #b91c1c;">- 핵심원인: </span><strong id="modalCoreCause"></strong></li>
                    <li><span style="font-weight: bold; color: #b91c1c;">- 물적손실: </span><strong id="modalMaterialLoss"></strong></li>
                    <li><span style="font-weight: bold; color: #b91c1c;">- 인적피해: </span><strong id="modalHumanInjury"></strong></li>
                </ul>
