                  ]
                }
                제공된 재해 정보를 종합적으로 고려하여, 선택된 핵심 주제 "${selectedMandalartCoreCause}"를 중앙 주제로 설정하고, 이와 관련된 8가지 핵심 세부 원인(mainCategories)을 생성해주세요. 각 세부 원인에 대해 다시 8가지의 매우 구체적이고 실질적인 구체적 원인(subCauses)을 생성해주세요.

                재해 정보: ${JSON.stringify(globalAccidentDetails)}`;

                let chatHistory = [];
                chatHistory.push({ role: "user", parts: [{ text: mandalartPrompt }] });

                const payload = {
                    contents: chatHistory,
                    generationConfig: {
                        responseMimeType: "application/json",
                        responseSchema: {
                            type: "OBJECT",
                            properties: {
                                "centralTheme": { "type": "STRING" },
                                "mainCategories": {
                                    "type": "ARRAY",
                                    "items": {
                                        "type": "OBJECT",
                                        "properties": {
                                            "name": { "type": "STRING" },
                                            "subCauses": { "type": "ARRAY", "items": { "type": "STRING" } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                };

                const apiKey = "AIzaSyDXQi-WDl4GklWpWdbVzWnxjeApNru1-u0"; // API 키는 런타임에 자동으로 제공됩니다.
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-05-20:generateContent?key=${apiKey}`;

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (result.candidates && result.candidates[0]?.content?.parts?.[0]) {
                    const jsonText = result.candidates[0].content.parts[0].text;
                    const parsedJson = JSON.parse(jsonText);
                    globalMandalartData = parsedJson;
                    renderMandalart3x3(globalMandalartData);
                    expandMandalartButton.style.display = 'block';
                    expandMandalartButton.disabled = false;

                    selectedCoreCauseDisplay.textContent = `핵심원인: ${selectedMandalartCoreCause}`;
                    selectedCoreCauseDisplay.style.display = 'block';
                    coreCausesSelect.style.display = 'none';
                } else {
                    messageElement.textContent = '계층별 퍼즐 데이터를 생성하는 데 실패했습니다.';
                    messageElement.style.display = 'block';
                }
            } catch (error) {
                console.error('API 호출 중 오류 발생:', error);
                messageElement.textContent = '계층별 퍼즐 생성 중 오류가 발생했습니다.';
                messageElement.style.display = 'block';
            } finally {
                mandalartLoadingSpinner.style.display = 'none';
                generateMandalartButton.disabled = false;
                generateOverviewButton.disabled = false;
                resetButton.disabled = false;
            }
        });
        
        // 기타 이벤트 리스너 (확장, 모달 닫기 등)
        expandMandalartButton.addEventListener('click', () => {
            if (globalMandalartData) {
                if (!isMandalartExpanded) renderMandalart9x9(globalMandalartData);
                else renderMandalart3x3(globalMandalartData);
            }
        });

        closeSubMandalartModalButton.addEventListener('click', closeSubMandalartModal);
        subMandalartModal.addEventListener('click', (event) => {
            if (event.target === subMandalartModal) closeSubMandalartModal();
        });

        resetButton.addEventListener('click', resetAll);

        showAccidentDetailsButton.addEventListener('click', () => {
            if (!globalAccidentDetails || !globalMandalartData) {
                messageElement.textContent = '표시할 데이터가 없습니다.';
                messageElement.style.display = 'block';
                return;
            }

            modalOverviewText.textContent = globalAccidentDetails.overview || '';
            modalCoreCause.textContent = selectedMandalartCoreCause || '정보 없음';
            modalMaterialLoss.textContent = globalAccidentDetails.materialLoss || '정보 없음';
            modalHumanInjury.textContent = globalAccidentDetails.humanInjury || '정보 없음';
            if(modalSubCausesCoreCause) {
                modalSubCausesCoreCause.textContent = selectedMandalartCoreCause || '정보 없음';
            }

            modalMainCausesList.innerHTML = '';
            globalAccidentDetails.mainCauses?.forEach(cause => {
                const li = document.createElement('li');
                li.textContent = `- ${cause.trim()}`;
                modalMainCausesList.appendChild(li);
            });

            modalPreventionMeasuresList.innerHTML = '';
            globalAccidentDetails.preventionMeasures?.forEach(measure => {
                const li = document.createElement('li');
                li.textContent = `- ${measure.trim()}`;
                modalPreventionMeasuresList.appendChild(li);
            });

            modalSubCausesTableBody.innerHTML = '';
            globalMandalartData.mainCategories?.forEach(mainCat => {
                const row = document.createElement('tr');
                const mainCauseCell = document.createElement('td');
                mainCauseCell.textContent = mainCat.name;
                row.appendChild(mainCauseCell);

                const subCausesCell = document.createElement('td');
                const ul = document.createElement('ul');
                ul.classList.add('bullet-list');
                mainCat.subCauses?.forEach(subCause => {
                    const li = document.createElement('li');
                    li.textContent = `- ${subCause.trim()}`;
                    ul.appendChild(li);
                });
                subCausesCell.appendChild(ul);
                row.appendChild(subCausesCell);
                modalSubCausesTableBody.appendChild(row);
            });

            accidentDetailsModal.style.display = 'flex';
        });

        closeAccidentDetailsModalButton.addEventListener('click', () => {
            accidentDetailsModal.style.display = 'none';
        });

        accidentDetailsModal.addEventListener('click', (event) => {
            if (event.target === accidentDetailsModal) {
                accidentDetailsModal.style.display = 'none';
            }
        });
    </script>
</body>
</html>

